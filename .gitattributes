# Keep text files LF in the repository so a Windows checkout and a Linux CI run
# produce the same bytes. Binary assets are listed so Git never tries to diff or
# merge them as text.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.zip binary
*.mp4 binary
*.pdf binary

# Gradle and Kotlin wrappers must keep their exact bytes.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf
